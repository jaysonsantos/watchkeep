  "query": "SELECT player AS \"label!\",\n                  COUNT(*) AS \"plays!\",\n                  COALESCE(SUM(runtime_ms), 0)::bigint AS \"runtime_ms!\"\n           FROM play_details\n           WHERE player IS NOT NULL AND player <> ''\n           GROUP BY player\n           ORDER BY COUNT(*) DESC, player\n           LIMIT $1",
