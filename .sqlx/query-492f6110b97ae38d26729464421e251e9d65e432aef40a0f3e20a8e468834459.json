  "query": "SELECT se.show_id, COUNT(*) AS \"count!\"\n               FROM tmdb_episode e JOIN tmdb_season se ON se.id = e.season_id\n               WHERE se.show_id = ANY($1) AND se.season_number > 0 AND (e.air_date IS NULL OR e.air_date <= $2)\n               GROUP BY se.show_id",
