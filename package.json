{
  "name": "watchkeep-frontend",
  "version": "0.5.0",
  "description": "Web UI of Watchkeep. The Rust server serves the build output.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "format": "biome check --write .",
    "lint": "biome ci .",
    "prepare": "svelte-kit sync || echo ''",
    "test": "node --test --experimental-transform-types 'frontend/test/**/*.test.ts'",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.5.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "packageManager": "pnpm@11.25.0"
}
