# Copy to .env and edit. Docker Compose reads this file.

# Password of the Postgres user `watchkeep` (both databases).
POSTGRES_PASSWORD=change-me

# Shared secret. Plex must call http://<host>:8484/webhook/plex?token=<this value>
WATCHKEEP_WEBHOOK_TOKEN=change-me-too

# Port on the host.
WATCHKEEP_PORT=8484

# Title language from the TMDB catalog: en or pt.
WATCHKEEP_CATALOG_LANGUAGE=en

# Optional. Enables "Sync Plex library" (imports the library and Plex watch state).
WATCHKEEP_PLEX_URL=
WATCHKEEP_PLEX_TOKEN=
# Optional. Sync on a timer, in minutes. 0 disables.
WATCHKEEP_SYNC_INTERVAL_MINUTES=0

# Optional. Comma-separated Plex account titles or ids to accept. Empty accepts all.
WATCHKEEP_PLEX_ACCOUNTS=

# A stop event at or above this percentage counts as watched.
WATCHKEEP_WATCHED_THRESHOLD_PERCENT=85
