{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!frontend/build",
      "!.svelte-kit",
      "!target",
      "!.sqlx",
      "!frontend/src/lib/generated"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "html": {
    "formatter": {
      // Keep the two-space indent inside <script> and <style> of the Svelte files.
      "indentScriptAndStyle": true
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      // Biome reads only the <script> block of a Svelte file. Imports and variables that the
      // markup uses look unused to it. svelte-check reports the real unused ones.
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      // The stylesheet puts the base rules after the component rules that override them.
      "includes": ["frontend/src/app.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    }
  ]
}
